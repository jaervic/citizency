{
  "expo": {
    "name": "ciudadania-app",
    "slug": "ciudadania-app",
    "scheme": "ciudadania-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permite a esta app transcribir tu respuesta hablada para el simulacro de entrevista.",
        "NSMicrophoneUsageDescription": "Permite a esta app usar el micrófono para el simulacro de entrevista."
      }
    },
    "android": {
      "package": "app.ciudadania.estudio",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite a esta app usar el micrófono para el simulacro de entrevista.",
          "speechRecognitionPermission": "Permite a esta app transcribir tu respuesta hablada para el simulacro de entrevista."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bf4f1b4-b34a-473b-b895-3b80fa2e7de1"
      }
    },
    "owner": "jaervic"
  }
}
